---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Newsletter from '../components/Newsletter.astro';
import Dial from '../components/Dial.astro';
import { SITE, CATEGORIES } from '../data/site';

const all = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const featured = all.find((a) => a.data.featured) ?? all[0];
const latest = all.filter((a) => a.id !== featured?.id).slice(0, 6);
const counts = Object.fromEntries(
  Object.keys(CATEGORIES).map((k) => [k, all.filter((a) => a.data.category === k).length])
);
---
<Base>
  <!-- Hero -->
  <section class="hero">
    <Dial class="hero__dial" />
    <div class="wrap hero__inner">
      <span class="eyebrow">A journal on cinema &amp; horology</span>
      <h1>Where the screen<br /> tells time</h1>
      <p>The watches actors wore on screen, the stories behind them, and the pieces we would cast today. New articles every week.</p>
      <div class="btn-row">
        <a class="btn btn--light" href="/articles/">Read the journal</a>
        <a class="btn btn--outline-light" href={SITE.instagram} target="_blank" rel="noopener">Follow on Instagram</a>
      </div>
    </div>
  </section>

  <!-- Featured -->
  {featured && (
    <section class="section">
      <div class="wrap">
        <a class="feature" href={`/articles/${featured.id}/`}>
          <div class="feature__media"><img src={featured.data.cover} alt={featured.data.coverAlt || featured.data.title} width="1200" height="800" /></div>
          <div class="feature__body">
            <span class="eyebrow">Featured · {CATEGORIES[featured.data.category].label}</span>
            <h2>{featured.data.title}</h2>
            <p>{featured.data.description}</p>
            {(featured.data.film || featured.data.watch) && (
              <dl class="feature__facts">
                {featured.data.film && (<div><dt>Film</dt><dd>{featured.data.film}</dd></div>)}
                {featured.data.watch && (<div><dt>Watch</dt><dd>{featured.data.watch}</dd></div>)}
              </dl>
            )}
            <span class="btn">Read the story</span>
          </div>
        </a>
      </div>
    </section>
  )}

  <!-- Latest -->
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">The Journal</span>
        <h2>Latest articles</h2>
      </div>
      <div class="grid grid--3">
        {latest.map((a) => <ArticleCard article={a} />)}
      </div>
      <div class="center-cta"><a class="btn btn--ghost" href="/articles/">All articles</a></div>
    </div>
  </section>

  <!-- Categories -->
  <section class="section section--tinted">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Browse</span>
        <h2>Articles by category</h2>
      </div>
      <div class="grid grid--4">
        {Object.entries(CATEGORIES).map(([key, c], i) => (
          <a class="cat" href={`/category/${key}/`}>
            <span class="cat__num">0{i + 1}</span>
            <h3>{c.label}</h3>
            <p>{c.blurb}</p>
            <span class="cat__count">{counts[key]} {counts[key] === 1 ? 'article' : 'articles'}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- About -->
  <section class="section">
    <div class="wrap about">
      <div class="about__mark">
        <Dial class="about__dial" />
        <span class="about__word">C<i>&amp;</i>C</span>
      </div>
      <div class="about__body">
        <span class="eyebrow">Meet Cult &amp; Crown</span>
        <h2>Every great scene has a watch in it</h2>
        <p>Cult &amp; Crown started on Instagram with a simple question: what is that on his wrist? Behind almost every iconic character there is a costume designer, a prop master or an actor who chose a watch for a reason.</p>
        <p>We dig into those choices. The real references, the history of the brands, and the details you only notice on the third viewing.</p>
        <a class="btn btn--ghost" href="/about/">Our story</a>
      </div>
    </div>
  </section>

  <!-- Community -->
  <section class="section section--tinted">
    <div class="wrap community">
      <span class="eyebrow">The Community</span>
      <h2>Guess the watch, before the credits roll</h2>
      <p>Reels on the watches of cinema, weekly quizzes in our Stories and a community of film and watch lovers. Join us on Instagram.</p>
      <div class="btn-row"><a class="btn" href={SITE.instagram} target="_blank" rel="noopener">@cultandcrown</a></div>
    </div>
  </section>

  <Newsletter />
</Base>

<style>
  .hero { position: relative; overflow: hidden; background: var(--teal); color: var(--white); padding: 120px 0 128px; text-align: center; }
  :global(.hero__dial) { position: absolute; width: 720px; height: 720px; left: 50%; top: 50%; transform: translate(-50%, -50%); color: rgba(255,255,255,.09); pointer-events: none; }
  .hero__inner { position: relative; max-width: 820px; }
  .hero .eyebrow { color: rgba(255,255,255,.75); }
  .hero h1 { font-size: clamp(46px, 8vw, 92px); line-height: 1.02; margin: 22px 0 26px; }
  .hero p { font-size: 19px; color: rgba(255,255,255,.85); max-width: 560px; margin: 0 auto 40px; }
  @media (max-width: 640px) {
    .hero { padding: 80px 0 88px; }
    :global(.hero__dial) { width: 520px; height: 520px; }
    .hero h1 br { display: none; }
    .hero p { font-size: 17px; }
  }

  .feature { display: grid; grid-template-columns: 1.25fr 1fr; background: var(--teal); color: var(--white); }
  .feature__media { min-height: 100%; aspect-ratio: 3 / 2; overflow: hidden; }
  .feature__media img { width: 100%; height: 100%; object-fit: cover; transition: transform .6s; }
  .feature:hover .feature__media img { transform: scale(1.03); }
  .feature__body { display: flex; flex-direction: column; justify-content: center; align-items: flex-start; gap: 18px; padding: 48px; }
  .feature .eyebrow { color: rgba(255,255,255,.75); }
  .feature h2 { font-size: clamp(32px, 3.4vw, 44px); }
  .feature p { color: rgba(255,255,255,.85); }
  .feature__facts { display: flex; gap: 32px; margin: 4px 0 8px; }
  .feature__facts dt { font-size: 11px; letter-spacing: .18em; text-transform: uppercase; color: rgba(255,255,255,.6); }
  .feature__facts dd { white-space: nowrap; margin: 4px 0 0; font-family: var(--serif); font-size: 19px; }
  .feature .btn { background: var(--white); color: var(--teal); border-color: var(--white); }
  @media (max-width: 900px) {
    .feature { grid-template-columns: 1fr; }
    .feature__body { align-items: center; text-align: center; padding: 36px 24px 40px; }
    .feature__facts { justify-content: center; }
  }

  .cat { display: flex; flex-direction: column; height: 100%; padding: 32px 28px; background: var(--white); border: 1px solid var(--line); transition: border-color .2s, background .2s, color .2s; }
  .cat:hover { background: var(--teal); border-color: var(--teal); color: var(--white); }
  .cat__num { font-family: var(--serif); font-size: 18px; color: var(--teal); }
  .cat h3 { font-size: 28px; margin: 18px 0 12px; }
  .cat p { font-size: 15px; color: var(--muted); }
  .cat__count { margin-top: auto; padding-top: 24px; font-size: 12px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--teal); }
  .cat:hover .cat__num, .cat:hover p, .cat:hover .cat__count { color: rgba(255,255,255,.85); }
  @media (max-width: 640px) { .cat { text-align: center; align-items: center; } }

  .about { display: grid; grid-template-columns: 1fr 1.2fr; gap: 72px; align-items: center; }
  .about__mark { position: relative; aspect-ratio: 1; background: var(--teal); display: grid; place-items: center; color: var(--white); overflow: hidden; }
  :global(.about__dial) { position: absolute; inset: 8%; width: 84%; height: 84%; color: rgba(255,255,255,.22); }
  .about__word { position: relative; font-family: var(--serif); font-size: clamp(64px, 9vw, 120px); line-height: 1; }
  .about__body { display: flex; flex-direction: column; align-items: flex-start; gap: 18px; }
  .about__body h2 { font-size: clamp(32px, 4vw, 46px); }
  .about__body p { color: var(--muted); }
  .about__body .btn { margin-top: 10px; }
  @media (max-width: 900px) {
    .about { grid-template-columns: 1fr; gap: 40px; }
    .about__mark { max-width: 420px; width: 100%; margin: 0 auto; }
    .about__body { align-items: center; text-align: center; }
  }

  .community { text-align: center; max-width: 720px; }
  .community h2 { font-size: clamp(32px, 4vw, 46px); margin: 10px 0 16px; }
  .community p { color: var(--muted); margin-bottom: 36px; }
</style>
