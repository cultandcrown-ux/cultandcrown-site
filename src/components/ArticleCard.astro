---
import Cover from './Cover.astro';
import { CATEGORIES } from '../data/site';
const { article } = Astro.props;
const d = article.data;
const locked = d.locked;
const date = d.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
const minutes = Math.max(3, Math.round((article.body ?? '').split(/\s+/).length / 220));
const Tag = locked ? 'div' : 'a';
---
<Tag class:list={['card', { 'card--locked': locked }]} href={locked ? undefined : `/articles/${article.id}/`} aria-disabled={locked ? 'true' : undefined}>
  <div class="card__media">
    <span class="badge">{CATEGORIES[d.category].label}</span>
    <Cover article={article} />
    {locked && (
      <div class="card__lock" aria-hidden="true">
        <svg width="34" height="34" viewBox="0 0 24 24" fill="none"><rect x="4.5" y="10.5" width="15" height="10" rx="2.5" stroke="currentColor" stroke-width="1.6"/><path d="M8 10.5V7.5a4 4 0 0 1 8 0v3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><circle cx="12" cy="15.5" r="1.4" fill="currentColor"/></svg>
        <span>Coming soon</span>
      </div>
    )}
  </div>
  <div class="card__body">
    <div class="card__meta">{locked ? <span>Coming soon</span> : <><span>{date}</span><span>·</span><span>{minutes} min read</span></>}</div>
    <h3 class="card__title">{d.title}</h3>
    <p class="card__excerpt">{d.description}</p>
    {locked
      ? <span class="card__more card__more--locked">Locked until publication</span>
      : <span class="card__more">Read the story
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>}
  </div>
</Tag>
