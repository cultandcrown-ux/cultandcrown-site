---
// Newsletter block. Sign-ups are saved in Cloudflare (functions/api/subscribe.js)
// until a newsletter provider is chosen.
---
<section id="newsletter" class="section newsletter-wrap">
  <div class="wrap">
    <div class="newsletter on-dark reveal">
      <img class="newsletter__bg" src="/images/newsletter-all-is-lost.webp" alt="" aria-hidden="true" loading="lazy" decoding="async" width="1920" height="1080" />
      <div class="newsletter__inner">
        <span class="eyebrow">The Cult &amp; Crown letter</span>
        <h2>New stories, every week</h2>
        <p>One email when a new article goes live. The film, the watch and the story behind the scene.</p>
        <form class="newsletter__form" action="/api/subscribe" method="post" data-newsletter>
          <label for="nl-email" class="visually-hidden">Email address</label>
          <input id="nl-email" type="email" name="email" placeholder="Email address" autocomplete="email" required />
          <input type="text" name="website" class="nl-hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <input type="hidden" name="source" value={Astro.url.pathname} />
          <button class="btn btn--light" type="submit">Subscribe</button>
        </form>
        <p class="newsletter__status" role="status" aria-live="polite" hidden></p>
        <small>We only use your email to send the Cult &amp; Crown letter. No spam, unsubscribe anytime. <a href="/privacy/">Privacy policy</a></small>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-newsletter]').forEach((form) => {
    const status = form.parentElement?.querySelector<HTMLElement>('.newsletter__status');
    const button = form.querySelector('button');
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!status || !button) return;
      button.disabled = true;
      button.textContent = 'Sending…';
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form) });
        const data = await res.json().catch(() => ({}));
        if (res.ok && data.ok) {
          form.hidden = true;
          status.textContent = data.already ? "You're already on the list. Thank you!" : "You're in. See you in your inbox.";
          status.dataset.state = 'ok';
        } else {
          status.textContent = data.error === 'invalid_email' ? 'Please check your email address.' : 'Something went wrong. Please try again later.';
          status.dataset.state = 'error';
        }
      } catch {
        status.textContent = 'Something went wrong. Please try again later.';
        status.dataset.state = 'error';
      }
      status.hidden = false;
      button.disabled = false;
      button.textContent = 'Subscribe';
    });
  });
</script>

<style>
  .newsletter-wrap { padding-top: 0; }
  .newsletter {
    position: relative; overflow: hidden; border-radius: var(--r-xl); color: var(--white); text-align: center;
    background: radial-gradient(120% 120% at 50% 0%, #0b6a76 0%, #004953 40%, #00222a 100%);
    padding: 96px 32px;
  }
  .newsletter { isolation: isolate; }
  .newsletter__bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 40% 30%; z-index: -2; }
  .newsletter::before { content: ''; position: absolute; inset: 0; z-index: -1; background: radial-gradient(70% 90% at 50% 55%, rgba(0,30,36,.86) 0%, rgba(0,34,42,.72) 60%, rgba(0,34,42,.55) 100%); }
  .newsletter__inner { position: relative; max-width: 620px; margin: 0 auto; }
  .newsletter h2 { font-size: clamp(36px, 5vw, 56px); margin: 12px 0 16px; }
  .newsletter p { color: rgba(255,255,255,.82); font-size: 19px; }
  .newsletter__form { display: flex; gap: 12px; justify-content: center; margin: 36px auto 16px; max-width: 520px; }
  .newsletter__form input {
    flex: 1; min-width: 0; height: var(--cta-h); padding: 0 22px; font: inherit; font-size: 16px; border-radius: 999px;
    background: rgba(255,255,255,.1); color: var(--white); border: 1px solid rgba(255,255,255,.3);
  }
  .newsletter__form input::placeholder { color: rgba(255,255,255,.6); }
  .newsletter__form input:focus { outline: none; border-color: var(--white); background: rgba(255,255,255,.16); }
  .nl-hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .newsletter__status { margin: 0 auto 16px; max-width: 520px; font-size: 17px; font-weight: 500; }
  .newsletter__status[data-state='ok'] { margin-top: 32px; font-family: var(--serif); font-size: 26px; font-weight: 400; color: var(--white); }
  .newsletter__status[data-state='error'] { color: #ffd2cc; }
  .newsletter small a { color: rgba(255,255,255,.85); text-decoration: underline; text-underline-offset: 2px; }
  .newsletter small { font-size: 13px; color: rgba(255,255,255,.6); }
  @media (max-width: 640px) {
    .newsletter { padding: 64px 20px; }
    .newsletter p { font-size: 17px; }
    .newsletter__form { flex-direction: column; align-items: center; }
    .newsletter__form input, .newsletter__form .btn { flex: none; width: 100%; max-width: 320px; }
  }
</style>
