---
// Newsletter block. To make it live, replace FORM_ACTION with the form URL
// from your newsletter provider (e.g. Kit, Buttondown, MailerLite).
const FORM_ACTION = '';
---
<section class="section section--dark newsletter">
  <div class="wrap newsletter__inner">
    <span class="eyebrow">Newsletter</span>
    <h2>New stories, every week</h2>
    <p>One email when a new article goes live. The watch, the film, the story behind the scene.</p>
    <form class="newsletter__form" action={FORM_ACTION || undefined} method="post" target="_blank">
      <label for="nl-email" class="visually-hidden">Email address</label>
      <input id="nl-email" type="email" name="email" placeholder="Your email address" required />
      <button class="btn btn--light" type="submit">Subscribe</button>
    </form>
    <small>No spam. Unsubscribe anytime.</small>
  </div>
</section>

<style>
  .newsletter__inner { text-align: center; max-width: 640px; }
  .newsletter h2 { font-size: clamp(32px, 4vw, 46px); margin: 10px 0 14px; }
  .newsletter p { color: rgba(255,255,255,.82); }
  .newsletter__form { display: flex; gap: 12px; margin: 32px auto 14px; max-width: 520px; }
  .newsletter__form input {
    flex: 1; min-width: 0; height: 52px; padding: 0 18px; font: inherit; font-size: 15px;
    background: transparent; color: var(--white); border: 1px solid rgba(255,255,255,.5); border-radius: 0;
  }
  .newsletter__form input::placeholder { color: rgba(255,255,255,.6); }
  .newsletter__form input:focus { outline: none; border-color: var(--white); }
  .newsletter small { font-size: 12px; color: rgba(255,255,255,.6); letter-spacing: .04em; }
  @media (max-width: 560px) {
    .newsletter__form { flex-direction: column; align-items: center; }
    .newsletter__form input, .newsletter__form .btn { flex: none; width: 100%; max-width: 320px; }
  }
</style>
